---
import { BLOQUE3_CONFIG, buildWhatsAppUrl } from "../data/bloque3";

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const quickWaUrl = buildWhatsAppUrl(
  "Hola Bloque3, quiero consultar sobre automatización o desarrollo de un sitio web."
);

const navItems = [
  { label: "Servicios", href: `${baseUrl}#servicios` },
  { label: "Proyectos", href: `${baseUrl}#proyectos` },
  { label: "Verificadores", href: `${baseUrl}#verificadores` },
  { label: "Desarrolladores", href: `${baseUrl}#desarrolladores` },
];
---

<header class="sticky top-0 z-40 border-b border-rule bg-paper/92 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-5 sm:px-8 h-16 flex items-center justify-between gap-4">
    <a href={baseUrl} class="inline-flex items-center gap-3 group" aria-label="Inicio Bloque3">
      <svg
        width="28"
        height="28"
        viewBox="0 0 64 64"
        fill="none"
        aria-hidden="true"
        class="transition-transform duration-200 group-hover:scale-105"
      >
        <rect width="64" height="64" rx="8" fill="#111214" />
        <rect x="12" y="13" width="17" height="17" rx="2" fill="#F3F0E8" />
        <rect x="35" y="13" width="17" height="17" rx="2" fill="#D9481E" />
        <rect x="12" y="34" width="40" height="17" rx="2" fill="#F3F0E8" />
      </svg>
      <div class="flex items-baseline gap-2">
        <span class="font-display font-bold text-lg tracking-tight text-ink">BLOQUE3</span>
        <span class="hidden sm:inline font-mono text-[11px] text-ink-muted tracking-wider uppercase">
          // LAB & STUDIO
        </span>
      </div>
    </a>

    <nav class="hidden md:flex items-center gap-7" aria-label="Navegación principal">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="text-sm font-medium text-ink-muted hover:text-ink transition-colors"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={BLOQUE3_CONFIG.githubOrgUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center font-mono text-xs px-3 py-2 border border-rule text-ink hover:border-ink transition-colors"
      >
        GitHub
      </a>
      <a
        href={quickWaUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-ink text-paper hover:bg-signal transition-colors text-xs sm:text-sm font-medium px-4 py-2"
      >
        <span>WhatsApp</span>
        <span aria-hidden="true">↗</span>
      </a>
      <button
        id="mobile-menu-toggle"
        type="button"
        class="md:hidden inline-flex items-center justify-center w-9 h-9 border border-rule text-ink"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="7" x2="21" y2="7" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="17" x2="21" y2="17" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-rule bg-paper px-5 py-4">
    <nav class="flex flex-col gap-3" aria-label="Menú móvil">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="mobile-nav-link text-sm font-medium text-ink py-1.5 border-b border-rule/60 last:border-b-0"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={BLOQUE3_CONFIG.githubOrgUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm font-mono text-ink-muted py-1.5"
      >
        GitHub Organization ↗
      </a>
    </nav>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById("mobile-menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener("click", () => {
      const expanded = toggleBtn.getAttribute("aria-expanded") === "true";
      toggleBtn.setAttribute("aria-expanded", String(!expanded));
      mobileMenu.classList.toggle("hidden");
    });

    mobileMenu.querySelectorAll(".mobile-nav-link").forEach((link) => {
      link.addEventListener("click", () => {
        toggleBtn.setAttribute("aria-expanded", "false");
        mobileMenu.classList.add("hidden");
      });
    });
  }
</script>
