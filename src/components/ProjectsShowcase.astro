---
import { PROJECTS, BLOQUE3_CONFIG } from "../data/bloque3";
---

<section id="proyectos" class="bg-obsidian text-obsidian-ink bg-draft-grid-dark border-b border-obsidian-rule">
  <div class="max-w-7xl mx-auto px-5 sm:px-8 py-16 sm:py-24">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-10 border-b border-obsidian-rule">
      <div class="space-y-3 max-w-2xl">
        <p class="inline-flex items-center gap-2 font-mono text-xs tracking-wider uppercase text-signal font-medium">
          <span class="inline-block w-2 h-2 bg-signal"></span>
          <span>02 / Portafolio de Productos &amp; Laboratorio</span>
        </p>
        <h2 class="font-display font-bold text-3xl sm:text-4xl tracking-tight text-obsidian-ink">
          Herramientas dev, juegos y plataformas construidas desde cero.
        </h2>
        <p class="text-sm text-obsidian-ink/75 leading-relaxed max-w-xl">
          Combinamos proyectos de código abierto con productos privados y comerciales según la naturaleza de cada iniciativa.
        </p>
      </div>
      <a
        href={BLOQUE3_CONFIG.githubOrgUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 font-mono text-xs px-4 py-2.5 border border-obsidian-rule hover:border-signal hover:text-signal text-obsidian-ink transition-colors self-start md:self-auto"
      >
        <span>github.com/bloque3</span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>

    <div class="grid md:grid-cols-2 border-t border-l border-r border-obsidian-rule mt-10">
      {
        PROJECTS.map((project, idx) => (
          <article
            class={`bg-obsidian-card/85 border-b border-obsidian-rule p-6 sm:p-8 flex flex-col justify-between gap-6 ${
              idx % 2 === 0 ? "md:border-r md:border-obsidian-rule" : ""
            }`}
          >
            <div class="space-y-6">
              <div class="flex flex-wrap items-center justify-between gap-3">
                <span class="font-mono text-xs text-signal tracking-wider">
                  [{project.index}] // {project.category.toUpperCase()}
                </span>
                <span class="font-mono text-[11px] px-2.5 py-1 border border-obsidian-rule bg-obsidian-deep/80 text-obsidian-ink/85">
                  {project.visibility}
                </span>
              </div>

              {/* Bespoke technical schematic SVG aligned with Bloque3 Navy & Lime */}
              <div class="border border-obsidian-rule bg-obsidian-deep p-4 h-36 flex items-center justify-between overflow-hidden">
                {project.slug === "byte-lab" && (
                  <svg viewBox="0 0 320 96" class="w-full h-full" fill="none" aria-hidden="true">
                    <path d="M16 28H64M16 68H64" stroke="#7A96B2" stroke-width="1.5" />
                    <path d="M64 16H104C128 16 144 32 144 48C144 64 128 80 104 80H64V16Z" stroke="#F4F6F8" stroke-width="1.8" />
                    <path d="M144 48H184" stroke="#73FD43" stroke-width="1.8" />
                    <circle cx="184" cy="48" r="4" fill="#CEFC46" />
                    <rect x="202" y="20" width="104" height="56" stroke="#1E4B73" stroke-width="1.5" />
                    <text x="254" y="44" text-anchor="middle" fill="#F4F6F8" font-family="IBM Plex Mono, monospace" font-size="10">0x7F · ALU</text>
                    <text x="254" y="61" text-anchor="middle" fill="#CEFC46" font-family="IBM Plex Mono, monospace" font-size="9.5">IEEE-754 OK</text>
                  </svg>
                )}

                {project.slug === "acumulapp" && (
                  <svg viewBox="0 0 320 96" class="w-full h-full" fill="none" aria-hidden="true">
                    <rect x="16" y="14" width="160" height="68" stroke="#F4F6F8" stroke-width="1.5" />
                    <circle cx="44" cy="36" r="10" fill="#CEFC46" />
                    <circle cx="78" cy="36" r="10" stroke="#F4F6F8" stroke-width="1.5" />
                    <circle cx="112" cy="36" r="10" stroke="#F4F6F8" stroke-width="1.5" />
                    <circle cx="146" cy="36" r="10" stroke="#7A96B2" stroke-dasharray="3 3" stroke-width="1.5" />
                    <path d="M39 36L43 40L50 32" stroke="#081E32" stroke-width="2" />
                    <text x="96" y="68" text-anchor="middle" fill="#7A96B2" font-family="IBM Plex Mono, monospace" font-size="9.5">SELLOS QR · 3/4</text>
                    <rect x="218" y="16" width="64" height="64" stroke="#1E4B73" stroke-width="1.5" />
                    <rect x="228" y="26" width="16" height="16" stroke="#F4F6F8" stroke-width="1.5" />
                    <rect x="256" y="26" width="16" height="16" stroke="#F4F6F8" stroke-width="1.5" />
                    <rect x="228" y="54" width="16" height="16" stroke="#F4F6F8" stroke-width="1.5" />
                    <rect x="256" y="54" width="16" height="16" fill="#73FD43" />
                  </svg>
                )}

                {project.slug === "synapse-labs" && (
                  <svg viewBox="0 0 320 96" class="w-full h-full" fill="none" aria-hidden="true">
                    <polygon points="84,16 140,36 84,56 28,36" stroke="#F4F6F8" stroke-width="1.5" />
                    <polygon points="28,36 84,56 84,80 28,60" stroke="#7A96B2" stroke-width="1.5" />
                    <polygon points="140,36 84,56 84,80 140,60" stroke="#73FD43" stroke-width="1.5" />
                    <line x1="152" y1="48" x2="184" y2="48" stroke="#1E4B73" stroke-width="1.5" />
                    <circle cx="152" cy="48" r="2.5" fill="#73FD43" />
                    <rect x="184" y="20" width="122" height="56" stroke="#1E4B73" stroke-width="1.5" />
                    <text x="245" y="44" text-anchor="middle" fill="#F4F6F8" font-family="IBM Plex Mono, monospace" font-size="9.5">RACK TEMP: 72C</text>
                    <text x="245" y="61" text-anchor="middle" fill="#CEFC46" font-family="IBM Plex Mono, monospace" font-size="9.5">SWEET SPOT x2.4</text>
                  </svg>
                )}

                {project.slug === "agendate" && (
                  <svg viewBox="0 0 320 96" class="w-full h-full" fill="none" aria-hidden="true">
                    <rect x="20" y="16" width="280" height="64" stroke="#1E4B73" stroke-width="1.5" />
                    <line x1="20" y1="34" x2="300" y2="34" stroke="#1E4B73" stroke-width="1.5" />
                    <line x1="90" y1="16" x2="90" y2="80" stroke="#1E4B73" stroke-width="1" />
                    <line x1="160" y1="16" x2="160" y2="80" stroke="#1E4B73" stroke-width="1" />
                    <line x1="230" y1="16" x2="230" y2="80" stroke="#1E4B73" stroke-width="1" />
                    <rect x="96" y="40" width="58" height="32" fill="#CEFC46" />
                    <rect x="236" y="40" width="58" height="32" stroke="#F4F6F8" stroke-width="1.5" />
                    <text x="55" y="28" text-anchor="middle" fill="#7A96B2" font-family="IBM Plex Mono, monospace" font-size="9">09:00</text>
                    <text x="125" y="28" text-anchor="middle" fill="#F4F6F8" font-family="IBM Plex Mono, monospace" font-size="9">10:30</text>
                    <text x="195" y="28" text-anchor="middle" fill="#7A96B2" font-family="IBM Plex Mono, monospace" font-size="9">12:00</text>
                    <text x="265" y="28" text-anchor="middle" fill="#F4F6F8" font-family="IBM Plex Mono, monospace" font-size="9">14:00</text>
                  </svg>
                )}
              </div>

              <div class="space-y-3">
                <h3 class="font-display font-bold text-2xl text-obsidian-ink tracking-tight">
                  {project.name}
                </h3>
                <p class="text-sm sm:text-base text-obsidian-ink/80 leading-relaxed">
                  {project.description}
                </p>
              </div>

              <ul class="space-y-1.5">
                {project.highlights.map((item) => (
                  <li class="flex items-start gap-2.5 text-sm text-obsidian-ink/90">
                    <span class="font-mono text-signal shrink-0">—</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="pt-5 border-t border-obsidian-rule flex flex-wrap items-center justify-between gap-4">
              <div class="flex flex-wrap gap-1.5">
                {project.stack.map((tech) => (
                  <span class="font-mono text-[11px] px-2 py-1 bg-obsidian-deep border border-obsidian-rule text-obsidian-ink/90">
                    {tech}
                  </span>
                ))}
              </div>

              <div class="flex flex-wrap items-center gap-4">
                <span class="font-mono text-[11px] text-obsidian-ink/65">{project.repoSlug}</span>
                {project.publicUrl && (
                  <a
                    href={project.publicUrl.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-mono text-xs text-signal hover:text-obsidian-ink transition-colors inline-flex items-center gap-1"
                  >
                    <span>{project.publicUrl.label}</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
